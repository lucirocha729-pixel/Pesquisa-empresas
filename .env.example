# GOOGLE_MAPS_API_KEY: Chave do Google Maps Platform (Places API (New) + Geocoding API) mantida exclusivamente no servidor.
# Configure nas Variáveis de Ambiente da Vercel (Production/Preview) ou nos Secrets do ambiente. Nunca exponha no navegador.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GEMINI_API_KEY: Injetada automaticamente pelo ambiente quando aplicável.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública onde a aplicação está hospedada (ex: https://pesquisa-empresas.vercel.app).
APP_URL="MY_APP_URL"

# Variáveis opcionais do Firebase para sobrescrita na Vercel (fallback automático: firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""

