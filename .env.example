# GOOGLE_MAPS_API_KEY: Chave da Google Places API (New) mantida exclusivamente no servidor.
# Configure via painel de Secrets no ambiente de hospedagem. Nunca exponha no navegador.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GEMINI_API_KEY: Injetada automaticamente pelo ambiente quando aplicável.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública onde a aplicação está hospedada.
APP_URL="MY_APP_URL"
