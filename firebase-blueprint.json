{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil do usuário autenticado no Lead Finder Brasil.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID do usuário no Firebase Auth",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição do usuário",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "E-mail verificado do usuário",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "description": "URL do avatar do usuário",
          "maxLength": 500
        },
        "companyName": {
          "type": "string",
          "description": "Nome da agência ou consultoria do usuário",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de criação"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp da última atualização"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "CrmLead": {
      "title": "CrmLead",
      "description": "Registro próprio do CRM vinculado exclusivamente ao Place ID do Google Maps.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador do documento no CRM",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID do proprietário do lead no CRM",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "placeId": {
          "type": "string",
          "description": "Google Place ID permitido para armazenamento pelos Termos do Google Maps",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "crmName": {
          "type": "string",
          "description": "Nome de referência do prospecto cadastrado pelo usuário no CRM",
          "minLength": 1,
          "maxLength": 180
        },
        "segment": {
          "type": "string",
          "description": "Segmento empresarial no CRM",
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "description": "Cidade de referência da prospecção",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "description": "Estado ou UF",
          "maxLength": 50
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro de referência",
          "maxLength": 100
        },
        "websiteClassification": {
          "type": "string",
          "enum": [
            "SEM_SITE_INFORMADO_GOOGLE",
            "SITE_INFORMADO_GOOGLE",
            "VERIFICADO_SEM_SITE",
            "VERIFICADO_COM_SITE"
          ],
          "description": "Classificação de presença digital no Google ou verificada pelo vendedor"
        },
        "crmStatus": {
          "type": "string",
          "enum": ["novo", "contatado", "interessado", "cliente", "descartado"],
          "description": "Etapa comercial do lead no funil do CRM"
        },
        "notes": {
          "type": "string",
          "description": "Observações comerciais do usuário",
          "maxLength": 3000
        },
        "contactDate": {
          "type": "string",
          "description": "Data do contato comercial (YYYY-MM-DD)",
          "maxLength": 32
        },
        "contactChannel": {
          "type": "string",
          "description": "Canal de contato utilizado",
          "maxLength": 40
        },
        "customPhone": {
          "type": "string",
          "description": "Telefone anotado pelo usuário durante a prospecção",
          "maxLength": 40
        },
        "estimatedTicket": {
          "type": "number",
          "description": "Valor estimado da proposta comercial em BRL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no CRM"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no CRM"
        }
      },
      "required": [
        "id",
        "ownerId",
        "placeId",
        "crmName",
        "segment",
        "city",
        "state",
        "neighborhood",
        "websiteClassification",
        "crmStatus",
        "notes",
        "contactDate",
        "contactChannel",
        "customPhone",
        "estimatedTicket",
        "createdAt",
        "updatedAt"
      ]
    },
    "CrmHistoryEntry": {
      "title": "CrmHistoryEntry",
      "description": "Evento de histórico comercial registrado no CRM para um lead.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "leadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actionType": {
          "type": "string",
          "enum": [
            "lead_criado",
            "status_alterado",
            "contato_registrado",
            "observacao_adicionada",
            "dados_atualizados"
          ]
        },
        "fromStatus": {
          "type": "string",
          "maxLength": 30
        },
        "toStatus": {
          "type": "string",
          "maxLength": 30
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "contactDate": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "leadId",
        "actionType",
        "fromStatus",
        "toStatus",
        "note",
        "contactDate",
        "createdAt"
      ]
    },
    "SearchLog": {
      "title": "SearchLog",
      "description": "Registro agregado de sessão de busca para métricas do dashboard (sem armazenar conteúdo de diretório do Google Places).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "queryText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "country": {
          "type": "string",
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "neighborhood": {
          "type": "string",
          "maxLength": 100
        },
        "segment": {
          "type": "string",
          "maxLength": 100
        },
        "totalFound": {
          "type": "number"
        },
        "withoutWebsiteCount": {
          "type": "number"
        },
        "withWebsiteCount": {
          "type": "number"
        },
        "withPhoneCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "queryText",
        "country",
        "state",
        "city",
        "neighborhood",
        "segment",
        "totalFound",
        "withoutWebsiteCount",
        "withWebsiteCount",
        "withPhoneCount",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfil privado e preferências de workspace do usuário autenticado."
    },
    "/users/{userId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/CrmLead" },
      "description": "Leads comerciais do CRM pertencentes ao usuário, vinculados via placeId."
    },
    "/users/{userId}/leads/{leadId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/CrmHistoryEntry" },
      "description": "Histórico cronológico de interações comerciais de cada lead."
    },
    "/users/{userId}/searchLogs/{searchId}": {
      "schema": { "$ref": "#/entities/SearchLog" },
      "description": "Métricas agregadas das pesquisas realizadas pelo usuário para o Dashboard."
    }
  }
}
